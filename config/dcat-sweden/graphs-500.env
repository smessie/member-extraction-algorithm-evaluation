TYPE=EXTRACT_MEMBERS
EXEC_FILE="{CWD}/dist/extract-members-graphs.js"
WARMUP_FILE="{CWD}/dist/extract-members-graphs.js"
CLIENT_ARGUMENTS="LDES_PAGE,CBD_SPECIFY_SHAPE,CBD_DEFAULT_GRAPH"
WARMUP_ROUNDS=1
ITERATIONS=20
INGEST_PIPELINE="{CWD}/data/pipeline.ttl"
PAGE_SIZE=500
K_SPLIT=4
MIN_BUCKET_SPAN=21600  # 6 hours
INTERVAL=100
AMOUNT_PER_INTERVAL=1000
EXPECTED_COUNT=4768
POLL_INTERVAL=200
NGINX_CONFIG="{CWD}/nginx/configs/gzip.conf"
NGINX_SITE="{CWD}/nginx/ldes-server-cached.conf"
DATABASE_URL=redis://redis:6379
REPOSITORY_CONFIG_FILE="{CWD}/data/redis-config.json"
SERVER_NAMED_GRAPHS=true
NUM_CLIENTS=1
REPLICATION_DATA={CWD}/data/dcat-sweden.txt
METADATA_FILE={CWD}/data/metadata-dcat-sweden.ttl
COLLECT_METRICS_INTERVAL=100
TIMESTAMP_PATH="http://www.w3.org/ns/prov#generatedAtTime"
UNORDERED_RELATIONS=false
LDES_PAGE=http://{SERVER_HOSTNAME}:3000/ldes/default
CBD_SPECIFY_SHAPE=false
CBD_DEFAULT_GRAPH=false
